{
  "name": "feedtack",
  "version": "1.4.0",
  "description": "Click anywhere. Drop a pin. Get a payload a developer can act on.",
  "type": "module",
  "license": "MIT",
  "author": "Trillium Smith",
  "repository": {
    "type": "git",
    "url": "https://github.com/trillium/feedtack"
  },
  "keywords": [
    "feedback",
    "feedback-widget",
    "react",
    "user-feedback",
    "bug-reporting",
    "overlay",
    "feedback-overlay",
    "ux-feedback"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "build": "tsup",
    "build:extension": "tsup && bun run scripts/build-extension.ts",
    "build:docs": "pnpm --dir site-docs build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "release": "release-it --ci",
    "tack-server": "bun run examples/tack-server/server.ts",
    "patch-report": "bun run examples/tack-server/patch-report.ts",
    "fallow": "fallow",
    "fallow:health": "fallow health --score --top 20 --hotspots",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit",
    "openspec:archive": "openspec archive -y",
    "prepublishOnly": "pnpm test && pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "fallow": "^2.69.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "release-it": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  }
}
