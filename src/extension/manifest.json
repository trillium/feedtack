{
  "manifest_version": 3,
  "name": "Feedtack",
  "version": "1.0.0",
  "description": "Click anywhere. Drop a pin. Get a payload a developer can act on.",
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["feedtack.inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Feedtack",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
